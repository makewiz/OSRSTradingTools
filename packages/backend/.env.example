# ==============================================================================
# OSRS TRADING TOOLS - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in packages/backend/ (or set these in your Railway service).
# For minimal local development, only DATABASE_URL is required (handled by Docker).

# ------------------------------------------------------------------------------
# 1. CORE SETTINGS (Required for basic web app)
# ------------------------------------------------------------------------------
# Port the backend Express server listens on (default: 4000)
PORT=4000

# PostgreSQL connection string (Required)
# If using the included docker-compose setup: postgresql://user:password@localhost:5432/osrs_trading
DATABASE_URL=postgresql://user:password@localhost:5432/osrs_trading

# Secret key used to sign JWT authentication tokens
# In production, generate a strong random 32-byte secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# In local development, falls back to a default development secret if omitted.
JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 2. AI ASSISTANT & AUTONOMOUS AGENTS (Optional - Google Gemini)
# ------------------------------------------------------------------------------
# Required to enable the Global Chat AI Widget, Autonomous Trading Agents, and AI Market Highlights.
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. DISCORD OAUTH LOGIN (Optional - "Login with Discord")
# ------------------------------------------------------------------------------
# Get these from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# OAuth Redirect URI configured in your Discord Developer Application
# Local dev: http://localhost:5173/auth/discord/callback
# Production: https://your-frontend-domain.railway.app/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# (Optional) Restrict Discord login to members of a specific Discord Server (Guild)
# DISCORD_GUILD_ID=your_discord_guild_id
# (Optional) Discord Bot Token with Server Members intent (only needed if DISCORD_GUILD_ID is set)
# DISCORD_BOT_TOKEN=your_discord_bot_token

# ------------------------------------------------------------------------------
# 4. DISCORD BOT INTEGRATION (Optional - Backend <-> Bot API Communication)
# ------------------------------------------------------------------------------
# Shared secret key between the Backend and Discord Bot services.
# Must match the BOT_API_KEY configured in packages/discord-bot/.env
BOT_API_KEY=your_secure_random_bot_api_key

# ------------------------------------------------------------------------------
# 5. ACCESS CONTROL & APP BEHAVIOR (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to disable new user registrations and new Discord account creations
DISABLE_REGISTRATION=false

# Set to 'true' to require authentication before browsing items, prices, and tools
REQUIRE_AUTH=false

# Max days to retain historical price points (default: 7)
DATA_RETENTION_DAYS=7

# Contact info for the OSRS Wiki API User-Agent header (email, Discord handle, or project URL)
WIKI_CONTACT_INFO=unknown

# Logging level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 6. DEFAULT ADMIN AUTO-SEEDING (Optional)
# ------------------------------------------------------------------------------
# If specified, the backend will automatically create or promote this admin user on startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
ADMIN_EMAIL=admin@example.com