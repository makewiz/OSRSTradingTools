# ==============================================================================
# OSRS TRADING TOOLS - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in packages/frontend/ (optional for local development).
#
# In local development:
#   Leave unset or empty to use Vite's built-in proxy (/api -> http://localhost:4000).
#
# In production (e.g. Railway):
#   Set to your public backend URL:
#   VITE_API_URL=https://your-backend-domain.up.railway.app
# ------------------------------------------------------------------------------

VITE_API_URL=http://localhost:4000