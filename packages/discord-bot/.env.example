# ==============================================================================
# OSRS TRADING TOOLS - DISCORD BOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in packages/discord-bot/ (or set in your Railway Bot service).
# Only needed if you are running the Discord Bot service.

# ------------------------------------------------------------------------------
# 1. CORE DISCORD CREDENTIALS (Required for Discord Bot)
# ------------------------------------------------------------------------------
# Bot token from Discord Developer Portal (under "Bot" tab)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Application / Client ID from Discord Developer Portal (used for slash command registration)
DISCORD_CLIENT_ID=your_discord_client_id_here

# PostgreSQL database connection string (Required for direct watch lookups)
DATABASE_URL=postgresql://user:password@localhost:5432/osrs_trading

# Shared secret key matching packages/backend/.env BOT_API_KEY
BOT_API_KEY=your_secure_random_bot_api_key

# Backend API URL
# Local dev: http://localhost:4000
# Railway: http://<backend-service-name>.railway.internal:4000
BACKEND_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. OPTIONAL BOT FEATURES & SCHEDULING
# ------------------------------------------------------------------------------
# Frontend web URL used for links generated in Discord notifications & embeds
FRONTEND_URL=http://localhost:5173

# Channel ID to broadcast daily market highlights automatically
# DISCORD_HIGHLIGHTS_CHANNEL_ID=your_discord_channel_id

# Bot quiet / sleep hours (UTC 0-23) during which price alert DMs are silenced
# BOT_SLEEP_START=23
# BOT_SLEEP_END=7
